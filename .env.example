# Azure DevOps Configuration
# Copy this file to .env and fill in your actual values

# Your Azure DevOps organization URL
#AZURE_DEVOPS_ORG_URL=https://dev.azure.com/emstas
AZURE_DEVOPS_ORG_URL=


# Your Personal Access Token (PAT) with Build permissions
AZURE_DEVOPS_PAT=

# Your Azure DevOps project name
# AZURE_DEVOPS_PROJECT='Program Unify'
AZURE_DEVOPS_PROJECT=

# Your GitHub Personal Access Token
# This token should have permissions to access the repository and trigger builds
# GITHUB_PERSONAL_ACCESS_TOKEN=ghp_WqacJME16ezeejAF4pk5c0IVRIerer4M4gYE
GITHUB_PERSONAL_ACCESS_TOKEN=
